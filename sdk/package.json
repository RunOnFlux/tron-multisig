{
  "name": "@runonflux/tron-multisig",
  "version": "0.1.0",
  "description": "Pure-TypeScript SDK for SSP TRON multisig vaults: addresses, vault config and CREATE2 prediction, TIP-712 Op digests, signing, strict Op display decoding, canonical TRON protobuf transactions, a thin HTTP client and an escape-hatch CLI. Three dependencies.",
  "license": "MIT",
  "author": "RunOnFlux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunOnFlux/tron-multisig.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/RunOnFlux/tron-multisig#readme",
  "bugs": {
    "url": "https://github.com/RunOnFlux/tron-multisig/issues"
  },
  "keywords": [
    "tron",
    "trx",
    "usdt",
    "multisig",
    "tip-712",
    "create2",
    "wallet"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tron-multisig": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "TRON_WRITE_VECTORS=1 vitest run test/vectors.test.ts && prettier --write test/vectors",
    "prepublishOnly": "yarn type-check && yarn lint && yarn format:check && yarn test && yarn build",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "ethers": "6.17.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tronweb": "6.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
